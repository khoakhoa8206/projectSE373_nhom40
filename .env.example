# Sao chép thành .env rồi điền key. KHÔNG commit .env (lộ key bị trừ 1 điểm).
# Key OpenRouter: https://openrouter.ai/settings/keys
LLM_API_KEY=
# Danh sách model theo thứ tự ưu tiên, cách nhau bởi dấu phẩy (model đầu lỗi/bị giới hạn thì tự thử model sau)
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free
WEATHER_BASE_URL=http://127.0.0.1:8081

# Google AI Studio trực tiếp: dùng key Google ở LLM_API_KEY, thay LLM_MODEL bên trên bằng gemini-3.5-flash-lite.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Tự mặc định giãn 5 giây giữa request khi endpoint là Google; endpoint khác mặc định 0.
# Có thể đặt giá trị 0..120 giây, không bảo đảm vượt được quota token/ngày hoặc ứng dụng khác cùng project.
# LLM_MIN_INTERVAL_SECONDS=5
