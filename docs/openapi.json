    "/api/trips/{trip_id}/plan": {
      "post": {
        "summary": "Plan Trip",
        "description": "Chạy graph UC-02 tới bước người dùng duyệt: kết quả có `interrupt` (kind = itinerary_approval) để gửi lại\nqua /resume. Mặc định đồng bộ (1–2 phút); `?background=true` trả ngay {run_id} để PWA mở\nGET /api/runs/{run_id}/stream. Lỗi → 500 kèm run_id để xem trace.",
        "operationId": "plan_trip_api_trips__trip_id__plan_post",
        "parameters": [
          {
            "name": "trip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trip Id"
            }
          },
          {
            "name": "background",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Background"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
