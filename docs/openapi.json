  "components": {
    "schemas": {
      "Child": {
        "properties": {
          "age": {
            "type": "integer",
            "maximum": 17.0,
            "minimum": 0.0,
            "title": "Age"
          }
        },
        "type": "object",
        "required": [
          "age"
        ],
        "title": "Child"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JournalIn": {
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "day",
              "trip"
            ],
            "title": "Scope"
          },
          "day_index": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Day Index"
          },
          "lang": {
            "type": "string",
            "enum": [
              "vi",
              "en"
            ],
            "title": "Lang",
            "default": "vi"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scope"
        ],
        "title": "JournalIn",
        "description": "Body UC-09: nhật ký 1 ngày (scope = day, cần day_index) hoặc tóm tắt cả chuyến (scope = trip)."
      },
      "MemoryIn": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "value"
        ],
        "title": "MemoryIn"
      },
      "MessageIn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "MessageIn"
      },
      "NarrateIn": {
        "properties": {
          "poi_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poi Id"
          },
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "lang": {
            "type": "string",
            "enum": [
              "vi",
              "en"
            ],
            "title": "Lang"
          },
          "length": {
            "type": "string",
            "enum": [
              "short",
              "detail"
            ],
            "title": "Length",
            "default": "short"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lang"
        ],
        "title": "NarrateIn",
        "description": "Body UC-03: poi_id (UI tự tìm POI gần nhất, không bao giờ gửi toạ độ) và/hoặc câu hỏi."
      },
      "ResumeIn": {
        "properties": {
          "approval_id": {
            "type": "string",
            "title": "Approval Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "edited"
            ],
            "title": "Decision"
          },
          "response": {
            "title": "Response"
          }
        },
        "type": "object",
        "required": [
          "approval_id",
          "decision"
        ],
        "title": "ResumeIn"
      },
      "SessionIn": {
