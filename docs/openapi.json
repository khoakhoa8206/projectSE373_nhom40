{
  "openapi": "3.1.0",
  "info": {
    "title": "Tour Guide Agent API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/users": {
      "get": {
        "summary": "List Users",
        "description": "3 người dùng hư cấu cho màn hình chọn người dùng.",
        "operationId": "list_users_api_users_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "post": {
        "summary": "Login",
        "operationId": "login_api_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips": {
      "post": {
        "summary": "Create Trip",
        "description": "Nhận form hồ sơ → tạo trip + trip_profiles v1 (route = plan).",
        "operationId": "create_trip_api_trips_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{trip_id}/plan": {
      "post": {
        "summary": "Plan Trip",
        "description": "Chạy graph UC-02 (đồng bộ, có thể mất 1–2 phút). Lỗi → 500 kèm run_id để xem trace.",
        "operationId": "plan_trip_api_trips__trip_id__plan_post",
        "parameters": [
          {
            "name": "trip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trip Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{trip_id}/itinerary": {
      "get": {
        "summary": "Get Itinerary",
        "description": "Lịch trình mới nhất: slot (kèm tên + lat/lon POI) và vi phạm còn lại.",
        "operationId": "get_itinerary_api_trips__trip_id__itinerary_get",
        "parameters": [
          {
            "name": "trip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trip Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/trace": {
      "get": {
        "summary": "Get Trace",
        "description": "Các bước của 1 lượt chạy (node, tool, skill, LLM) cho panel log.",
        "operationId": "get_trace_api_runs__run_id__trace_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pois": {
      "get": {
        "summary": "List Pois",
        "description": "POI để vẽ bản đồ (dữ liệu công khai, không cần chọn người dùng).",
        "operationId": "list_pois_api_pois_get",
        "parameters": [
          {
            "name": "destination_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "hue",
              "title": "Destination Id"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Child": {
        "properties": {
          "age": {
            "type": "integer",
            "maximum": 17.0,
            "minimum": 0.0,
            "title": "Age"
          }
        },
        "type": "object",
        "required": [
          "age"
        ],
        "title": "Child"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SessionIn": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "SessionIn"
      },
      "TripProfile": {
        "properties": {
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          },
          "adults": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Adults"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/Child"
            },
            "type": "array",
            "title": "Children",
            "default": []
          },
          "mobility_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mobility Notes"
          },
          "budget_total_vnd": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Total Vnd"
          },
          "budget_includes": {
            "items": {
              "type": "string",
              "enum": [
                "lodging",
                "food",
                "tickets",
                "transport"
              ]
            },
            "type": "array",
            "title": "Budget Includes",
            "default": []
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interests",
            "default": []
          },
          "pace": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "relaxed",
                  "moderate",
                  "packed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Pace"
          },
          "language": {
            "type": "string",
            "enum": [
              "vi",
              "en"
            ],
            "title": "Language",
            "default": "vi"
          },
          "hard_constraints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hard Constraints",
            "default": []
          },
          "missing_info": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Info",
            "default": []
          },
          "route": {
            "type": "string",
            "enum": [
              "plan",
              "ask_user",
              "unsupported"
            ],
            "title": "Route",
            "default": "plan"
          }
        },
        "type": "object",
        "title": "TripProfile"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
